# CodeLens configuration example.
# Copy to .env (or set in your shell / container) and adjust as needed.
# Compose reads .env automatically for variable substitution.
# Frontend VITE_* variables are read at Vite build time.
# Backend vars are read at process start (not auto-loaded from this file —
# export them in the shell, systemd unit, or container environment).

# --- Frontend (build-time) ---
# Backend API base URL used by the React app (baked in at npm run build).
# Default native: http://127.0.0.1:8000
# Docker Compose default: http://localhost:8000 (host-mapped backend port).
# VITE_API_URL=http://localhost:8000

# --- Backend (runtime) ---
# Ollama base URL (no trailing slash required).
# Native default: http://127.0.0.1:11434
# Docker Compose default: http://host.docker.internal:11434 (host Ollama).
# Remote Ollama example:  http://192.168.1.50:11434
# CODELENS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama model name.
# Default: qwen2.5-coder:3b
# CODELENS_OLLAMA_MODEL=qwen2.5-coder:3b

# Allowed CORS origins for the frontend (comma-separated, no wildcards).
# Native Vite default: http://localhost:5173
# Docker Compose default: http://localhost:8080
# CODELENS_CORS_ORIGINS=http://localhost:5173

# Workspace data directory (repository files + repositories.json index).
# Native default: E:/CodeLensData (Windows local development).
# Container path is always /data/codelens (set inside docker-compose.yml).
# CODELENS_DATA_DIR=E:/CodeLensData

# --- Docker Compose only ---
# Host port for the frontend (Nginx). Default: 8080
# CODELENS_FRONTEND_PORT=8080

# Host port for the backend (FastAPI). Default: 8000
# CODELENS_BACKEND_PORT=8000

# Host directory bind-mounted to the backend at /data/codelens.
# Must be writable by the Docker daemon. Default: ./data (created on demand).
# To reuse existing Windows analysis data, point at that directory, e.g.:
#   CODELENS_HOST_DATA_DIR=E:/CodeLensData
# Never point this at a directory you cannot afford to share with containers.
# CODELENS_HOST_DATA_DIR=./data
